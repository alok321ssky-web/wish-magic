<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>✨ Secret Wish & Gift Magic Portal</title>
    
    <style>
        * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { margin: 0; padding: 15px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; display: flex; justify-content: center; align-items: center; }
        .container { background: #fff; width: 100%; max-width: 420px; border-radius: 16px; padding: 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); text-align: center; }
        h1 { color: #764ba2; font-size: 22px; margin-bottom: 4px; }
        .sub { color: #666; font-size: 12px; margin-bottom: 16px; }
        label { display: block; text-align: left; font-size: 13px; font-weight: bold; color: #444; margin-bottom: 4px; }
        input, select, textarea { width: 100%; padding: 10px; margin-bottom: 12px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; outline: none; background: #f9f9f9; }
        .btn-main { width: 100%; background: #764ba2; color: #fff; border: none; padding: 12px; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer; box-shadow: 0 4px 12px rgba(118, 75, 162, 0.3); }
        .btn-main:active { transform: scale(0.98); }
        .wish-card { margin-top: 20px; padding: 18px; border-radius: 12px; background: #f3f0ff; border: 2px dashed #764ba2; display: none; text-align: left; }
        .sub-text { font-size: 18px; color: #222; line-height: 1.6; font-weight: 700; margin-bottom: 15px; text-align: center; background: #fff; padding: 12px; border-radius: 8px; border: 1px solid #e0d4fc; }
        .memory-box { background: #fffde7; padding: 10px; border-radius: 8px; border: 1px solid #ffe082; font-size: 13px; color: #555; margin-bottom: 12px; text-align: left; }
        .btn-share { display: block; width: 100%; text-align: center; background: #25d366; color: white; padding: 12px; border-radius: 8px; font-weight: bold; text-decoration: none; margin-bottom: 8px; border: none; cursor: pointer; font-size: 15px; }
        .photo-preview { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; justify-content: center; }
        .photo-preview img { width: 70px; height: 70px; object-fit: cover; border-radius: 6px; border: 1px solid #ddd; }
        .audio-box { margin-bottom: 12px; text-align: left; background: #e8f5e9; padding: 10px; border-radius: 8px; border: 1px solid #c8e6c9; }
        #authScreen { display: block; }
        #mainApp { display: none; }
        #limitScreen { display: none; text-align: center; }
    </style>
</head>
<body>

    <!-- PASSWORD PROTECTION SCREEN -->
    <div class="container" id="authScreen">
        <h1>🔒 Secret Portal Access</h1>
        <p class="sub">Yeh portal secure hai. Access karne ke liye password dalein:</p>
        <input type="password" id="passInput" placeholder="Enter Secret Password...">
        <button class="btn-main" onclick="checkPassword()">🔓 Unlock Website</button>
        <p id="errorMsg" style="color: red; font-size: 12px; margin-top: 8px;"></p>
    </div>

    <!-- FREE LIMIT OVER SCREEN -->
    <div class="container" id="limitScreen">
        <h1>⚠️ Free Limit Reached</h1>
        <p class="sub">Aapne free version ki limit (1 wish) already use kar li hai!</p>
        <div style="background: #fff8e1; padding: 12px; border-radius: 8px; border: 1px solid #ffe0b2; font-size: 12px; margin-bottom: 15px; text-align: left;">
            💎 <b>Unlock Lifetime & Paid Features:</b><br>
            - Unlimited wishes<br>
            - 10 Photos Upload<br>
            - Voice Note Recording<br>
            - Special Memory Story Box<br><br>
            <b>Pay ₹20 via UPI to Creator:</b><br>
            <a href="upi://pay?pa=your-upi-id@paytm&pn=Alok&cu=INR" style="color: #764ba2; font-weight: bold; font-size: 14px;">⚡ Pay via UPI App</a>
        </div>
        <button class="btn-main" onclick="verifyPaidUser()">✅ I have Paid (Unlock Full Access)</button>
    </div>

    <!-- MAIN APP SCREEN -->
    <div class="container" id="mainApp">
        <h1>✨ AI Wish & Gift Studio</h1>
        <p class="sub" id="modeTitle">Free Mode (1 Wish Limit)</p>

        <label>🎯 Select Occasion</label>
        <select id="occasion">
            <option value="birthday">🎂 Birthday</option>
            <option value="anniversary">💍 Anniversary</option>
            <option value="festival">🎉 Festival</option>
            <option value="success">🏆 Success / Congrats</option>
        </select>

        <label>✍️ Select or Write Shayari / Message</label>
        <select id="shayariType" onchange="toggleCustomShayari()">
            <option value="ai">🤖 Generate Fresh AI Shayari</option>
            <option value="romantic">💖 Romantic & Sweet Shayari</option>
            <option value="funny">🔥 Fun & Dosti Shayari</option>
            <option value="custom">✏️ Write Your Own Custom Shayari</option>
        </select>
        <textarea id="customShayariBox" style="display:none;" placeholder="Apni custom shayari yahan likhein..."></textarea>

        <label>👤 Recipient Name</label>
        <input type="text" id="nameInput" placeholder="Jaise: Priya, Rahul...">

        <!-- PAID ONLY FEATURES WRAPPER -->
        <div id="paidFeatureSection" style="border: 2px dashed #764ba2; padding: 10px; border-radius: 10px; margin-bottom: 12px; background: #faf5ff; display:none;">
            <div style="color: #764ba2; font-weight: bold; font-size: 12px; margin-bottom: 8px;">💎 Paid Exclusive Features Active</div>
            
            <label>📸 Upload Photos (Up to 10 Photos)</label>
            <input type="file" id="imageInput" accept="image/*" multiple onchange="handleImageUpload()">
            <div class="photo-preview" id="imagePreviewContainer"></div>

            <label>📖 Special Memory / Secret Story</label>
            <textarea id="memoryInput" placeholder="Apni koi khaas yaad ya purani baat yahan likhein jo card mein dikhegi..."></textarea>

            <label>🎙️ Record Voice Note (Audio Wish)</label>
            <button type="button" id="recordBtn" class="btn-main" style="background:#e91e63; font-size:14px; padding:8px; margin-bottom:8px;" onclick="toggleRecording()">🔴 Start Voice Recording</button>
            <audio id="audioPlayback" controls style="width:100%; display:none;"></audio>
        </div>

        <div id="freePhotoSection">
            <label>📸 Upload Photos (Free: Max 2)</label>
            <input type="file" id="freeImageInput" accept="image/*" multiple onchange="handleFreeImageUpload()">
            <div class="photo-preview" id="freeImagePreviewContainer"></div>
        </div>

        <div style="background: #fff8e1; padding: 10px; border-radius: 6px; font-size: 11px; margin-bottom: 12px; text-align: left; border: 1px solid #ffe0b2;" id="upgradeBanner">
            💎 <b>Want Voice Note & 10 Photos?</b><br>
            Creator ko UPI pe ₹20 dekar unlock karein. <a href="upi://pay?pa=your-upi-id@paytm&pn=Alok&cu=INR" style="color: #764ba2; font-weight: bold;" onclick="localStorage.setItem('wish_paid', 'true')">Pay via UPI</a>
        </div>

        <button class="btn-main" onclick="generatePortalCard()">✨ Create & Preview Card</button>

        <div class="wish-card" id="wishCard">
            <div id="cardImages" class="photo-preview"></div>
            <div class="sub-text" id="wishText"></div>
            <div id="cardMemory" class="memory-box" style="display:none;"></div>
            <div id="cardAudioContainer" class="audio-box" style="display:none;">
                <div style="font-size:12px; font-weight:bold; color:#2e7d32; margin-bottom:4px;">🎙️ Voice Note from Sender:</div>
                <audio id="cardAudio" controls style="width:100%;"></audio>
            </div>
            <button class="btn-share" onclick="shareEverywhere()">🚀 Share Wish & Memories Everywhere</button>
        </div>
    </div>

    <script>
        const CORRECT_PASSWORD = "alok123";
        let mediaRecorder;
        let audioChunks = [];
        let recordedAudioUrl = "";
        let uploadedImages = [];

        window.onload = function() {
            // Check if user already used free wish
            const isPaid = localStorage.getItem('wish_paid') === 'true';
            const hasUsedFree = localStorage.getItem('wish_used_free') === 'true';

            if (isPaid) {
                activatePaidMode();
            } else if (hasUsedFree) {
                // Hide auth and show limit screen if trying to re-access without paying
            }
        };

        function checkPassword() {
            const enteredPass = document.getElementById('passInput').value;
            if (enteredPass === CORRECT_PASSWORD) {
                document.getElementById('authScreen').style.display = 'none';
                
                const isPaid = localStorage.getItem('wish_paid') === 'true';
                const hasUsedFree = localStorage.getItem('wish_used_free') === 'true';

                if (!isPaid && hasUsedFree) {
                    document.getElementById('limitScreen').style.display = 'block';
                } else {
                    document.getElementById('mainApp').style.display = 'block';
                    if (isPaid) activatePaidMode();
                }
            } else {
                document.getElementById('errorMsg').innerText = "❌ Galat password! Dobara koshish karein.";
            }
        }

        function verifyPaidUser() {
            localStorage.setItem('wish_paid', 'true');
            document.getElementById('limitScreen').style.display = 'none';
            document.getElementById('mainApp').style.display = 'block';
            activatePaidMode();
        }

        function activatePaidMode() {
            document.getElementById('modeTitle').innerText = "💎 Paid Pro Studio (Unlimited, 10 Photos & Voice Note)";
            document.getElementById('paidFeatureSection').style.display = 'block';
            document.getElementById('freePhotoSection').style.display = 'none';
            document.getElementById('upgradeBanner').style.display = 'none';
        }

        function toggleCustomShayari() {
            const val = document.getElementById('shayariType').value;
            document.getElementById('customShayariBox').style.display = (val === 'custom') ? 'block' : 'none';
        }

        // Free Image Upload (Max 2)
        function handleFreeImageUpload() {
            const input = document.getElementById('freeImageInput');
            const container = document.getElementById('freeImagePreviewContainer');
            container.innerHTML = "";
            uploadedImages = [];

            if (input.files.length > 2) {
                alert("⚠️ Free version mein sirf 2 photos allowed hain! Jyada ke liye paid mode use karein.");
            }
            const limit = Math.min(input.files.length, 2);
            for (let i = 0; i < limit; i++) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    uploadedImages.push(e.target.result);
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    container.appendChild(img);
                }
                reader.readAsDataURL(input.files[i]);
            }
        }

        // Paid Image Upload (Max 10)
        function handleImageUpload() {
            const input = document.getElementById('imageInput');
            const container = document.getElementById('imagePreviewContainer');
            container.innerHTML = "";
            uploadedImages = [];

            const limit = Math.min(input.files.length, 10);
            for (let i = 0; i < limit; i++) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    uploadedImages.push(e.target.result);
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    container.appendChild(img);
                }
                reader.readAsDataURL(input.files[i]);
            }
        }

        // Voice Recording Logic
        let isRecording = false;
        async function toggleRecording() {
            const btn = document.getElementById('recordBtn');
            const audioPlayback = document.getElementById('audioPlayback');

            if (!isRecording) {
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    mediaRecorder = new MediaRecorder(stream);
                    audioChunks = [];

                    mediaRecorder.ondataavailable = event => {
                        audioChunks.push(event.data);
                    };

                    mediaRecorder.onstop = () => {
                        const audioBlob = new Blob(audioChunks, { type: 'audio/mp3' });
                        recordedAudioUrl = URL.createObjectURL(audioBlob);
                        audioPlayback.src = recordedAudioUrl;
                        audioPlayback.style.display = 'block';
                    };

                    mediaRecorder.start();
                    isRecording = true;
                    btn.innerText = "⏹️ Stop & Save Voice Note";
                    btn.style.background = "#c62828";
                } catch (err) {
                    alert("Microphone access denied or not supported.");
                }
            } else {
                mediaRecorder.stop();
                isRecording = false;
                btn.innerText = "🔴 Record Again";
                btn.style.background = "#e91e63";
            }
        }

        function generatePortalCard() {
            const name = document.getElementById('nameInput').value.trim() || 'Dost';
            const occasion = document.getElementById('occasion').value;
            const shayariMode = document.getElementById('shayariType').value;
            const isPaid = localStorage.getItem('wish_paid') === 'true';

            // Mark free user as used
            if (!isPaid) {
                localStorage.setItem('wish_used_free', 'true');
            }
            
            let finalWish = "";
            if (shayariMode === 'custom') {
                finalWish = document.getElementById('customShayariBox').value || `Happy ${occasion}, ${name}!`;
            } else if (shayariMode === 'romantic') {
                finalWish = `✨ ${name}, tere aane se zindagi khubsurat ho gayi hai. Har pal bas teri khushi ki dua karte hain! ❤️`;
            } else if (shayariMode === 'funny') {
                finalWish = `🔥 Oye ${name}, party kab de raha hai bhai? Tu hi hai apna sabse bada superstar! 😎`;
            } else {
                const aiPools = [
                    `🌟 ${name}, khuda se kya maange tere vaste, zindagi ki har khushi tere raaste! Happy ${occasion}! ✨`,
                    `🚀 Sitaron se aage jahan aur bhi hain, ${name} ke liye nayi kamyabiyan aur bhi hain! Congratulations! 💫`,
                    `🎉 Din mahina aur saal, har lamha tera bemisaal rahe ${name}! Wishing you a wonderful ${occasion}! 🥂`
                ];
                finalWish = aiPools[Math.floor(Math.random() * aiPools.length)];
            }

            document.getElementById('wishText').innerText = finalWish;

            // Images
            const cardImgContainer = document.getElementById('cardImages');
            cardImgContainer.innerHTML = "";
            uploadedImages.forEach(src => {
                const img = document.createElement('img');
                img.src = src;
                cardImgContainer.appendChild(img);
            });

            // Memory Box (Paid only)
            if (isPaid) {
                const memoryText = document.getElementById('memoryInput').value.trim();
                const memoryBox = document.getElementById('cardMemory');
                if (memoryText) {
                    memoryBox.innerHTML = `📖 <b>Special Memory / Story:</b><br>${memoryText}`;
                    memoryBox.style.display = 'block';
                } else {
                    memoryBox.style.display = 'none';
                }

                // Audio
                const audioContainer = document.getElementById('cardAudioContainer');
                const cardAudio = document.getElementById('cardAudio');
                if (recordedAudioUrl) {
                    cardAudio.src = recordedAudioUrl;
                    audioContainer.style.display = 'block';
                } else {
                    audioContainer.style.display = 'none';
                }
            }

            const card = document.getElementById('wishCard');
            card.style.display = 'block';
            card.scrollIntoView({ behavior: 'smooth' });
        }

        function shareEverywhere() {
            const wish = document.getElementById('wishText').innerText;
            const shareText = `${wish}\n\n✨ Created via Secret Wish & Memory Portal`;

            if (navigator.share) {
                navigator.share({
                    title: 'Special Wish Card',
                    text: shareText,
                    url: window.location.href
                }).catch((error) => console.log('Sharing failed', error));
            } else {
                window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(shareText)}`, '_blank');
            }
        }
    </script>
</body>
</html>
